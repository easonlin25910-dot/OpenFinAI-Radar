# 复制本文件为 `.env` 并填入真实值；`.env` 已被 .gitignore 忽略，切勿提交。
# 生产环境（GitHub Actions）请改为：仓库 Settings → Secrets and variables → Actions，
# 按相同变量名逐个添加；代码只读环境变量，不会写入仓库。

# GitHub Personal Access Token（可选，提升 GitHub 搜索限流：60 次/时 -> 5000 次/时）
GITHUB_PAT=

# GitHub 推送用 Token（需要 Contents: Read and write，仅本地 git push 使用）
GITHUB_PUSH_TOKEN=

# Hugging Face User Access Token（可选，提升 HF 搜索限流）
HUGGINGFACE_TOKEN=

# Product Hunt Developer Token（接入 Product Hunt 时必填）
PRODUCTHUNT_TOKEN=

# Reddit OAuth（可选）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Lark / 飞书 自定义机器人（告警推送）
LARK_WEBHOOK=
LARK_SECRET=

# LLM 增强（未来可选）
OPENAI_API_KEY=
